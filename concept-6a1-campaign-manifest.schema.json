{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urban-ray-tracer.local/schema/concept-6a1-campaign-manifest.schema.json",
  "title": "A.T.O.M Concept 6A.1 campaign manifest",
  "description": "Strict acquisition and provenance contract. It describes raw receive-side collection and does not authorize calibration or canonical RF changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "campaign_version", "title", "campaign_date", "source_type", "collection_mode", "raw_format", "raw_preservation", "collector", "device", "receiver", "coordinate", "operator", "measurement", "detection", "known_limitations", "privacy"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/|-]{1,128}$"},
    "campaign_version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "campaign_date": {"type": "string", "format": "date"},
    "source_type": {"enum": ["synthetic_controlled", "local_field"]},
    "collection_mode": {"type": "string", "minLength": 1},
    "raw_format": {"const": "SIGNAL_COLLECTOR_TXT_V6"},
    "session_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "raw_preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keep_raw", "canonical_output_separate", "hash_algorithm", "raw_artifact_pattern", "no_overwrite"],
      "properties": {
        "keep_raw": {"const": true},
        "canonical_output_separate": {"const": true},
        "hash_algorithm": {"const": "sha256"},
        "raw_artifact_pattern": {"type": "string", "minLength": 1},
        "no_overwrite": {"const": true}
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform", "hardware_requirements", "root_required", "export_format", "quantities", "serving_identity", "frequency_metadata", "gps_metadata", "automation", "licensing", "permissions"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "hardware_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "root_required": {"const": false},
        "export_format": {"const": "SIGNAL_COLLECTOR_TXT_V6"},
        "quantities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "serving_identity": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "frequency_metadata": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "gps_metadata": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "automation": {"type": "string", "minLength": 1},
        "licensing": {"type": "string", "minLength": 1},
        "permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pseudonymous_id", "manufacturer", "model", "android_version", "antenna_id", "antenna_basis", "calibration_id", "calibration_state"],
      "properties": {
        "pseudonymous_id": {"type": "string", "minLength": 1},
        "manufacturer": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "android_version": {"type": "string", "minLength": 1},
        "antenna_id": {"type": "string", "minLength": 1},
        "antenna_basis": {"type": "string", "minLength": 1},
        "calibration_id": {"type": "string", "minLength": 1},
        "calibration_state": {"type": "string", "minLength": 1}
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height_agl_m", "height_source", "antenna_id", "antenna_basis", "calibration_id", "calibration_state"],
      "properties": {
        "height_agl_m": {"type": "number", "exclusiveMinimum": 0},
        "height_source": {"enum": ["measured", "configured", "assumed"]},
        "antenna_id": {"type": "string", "minLength": 1},
        "antenna_basis": {"type": "string", "minLength": 1},
        "calibration_id": {"type": "string", "minLength": 1},
        "calibration_state": {"type": "string", "minLength": 1}
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "crs", "max_accuracy_m", "timezone", "normalize_to_utc", "poor_position_action"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "crs": {"type": "string", "minLength": 1},
        "max_accuracy_m": {"type": "number", "exclusiveMinimum": 0},
        "timezone": {"type": "string", "minLength": 1},
        "normalize_to_utc": {"const": true},
        "poor_position_action": {"type": "string", "minLength": 1}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_name", "plmn", "network_context", "consent_note"],
      "properties": {
        "operator_name": {"type": "string", "minLength": 1},
        "plmn": {"type": "string", "pattern": "^[0-9]{5,6}$"},
        "network_context": {"type": "string", "minLength": 1},
        "consent_note": {"type": "string", "minLength": 1}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sampling_interval_ms", "fixed_point_window_seconds", "default_motion_state", "keep_stationary_separate", "aggregation_method", "preserve_repeated_samples", "neighbor_context_complete", "censoring_supported", "censoring_limitation", "los_annotation_policy", "outdoor_annotation_policy"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "sampling_interval_ms": {"type": "integer", "exclusiveMinimum": 0},
        "fixed_point_window_seconds": {"type": "integer", "exclusiveMinimum": 0},
        "default_motion_state": {"type": "string", "minLength": 1},
        "keep_stationary_separate": {"type": "boolean"},
        "aggregation_method": {"const": "raw"},
        "preserve_repeated_samples": {"const": true},
        "neighbor_context_complete": {"type": "boolean"},
        "censoring_supported": {"type": "boolean"},
        "censoring_limitation": {"type": "string", "minLength": 1},
        "los_annotation_policy": {"type": "string", "minLength": 1},
        "outdoor_annotation_policy": {"type": "string", "minLength": 1}
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "unavailable_representation", "invalid_representation", "censoring_representation"],
      "properties": {
        "available": {"type": "boolean"},
        "floors_dbm": {"type": "object", "additionalProperties": {"type": "number"}},
        "unavailable_representation": {"type": "string", "minLength": 1},
        "invalid_representation": {"type": "string", "minLength": 1},
        "censoring_representation": {"type": "string", "minLength": 1}
      }
    },
    "point_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "fixed_point_id", "site_id", "route_id", "point_window_seconds"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "fixed_point_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/|-]{1,128}$"},
          "site_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/|-]{1,128}$"},
          "route_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/|-]{1,128}$"},
          "los_nlos": {"enum": ["los", "nlos", "unknown", ""]},
          "los_source": {"type": "string"},
          "outdoor": {"type": ["boolean", "null"]},
          "point_window_seconds": {"type": "integer", "exclusiveMinimum": 0},
          "notes": {"type": "string"}
        }
      }
    },
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personal_identifiers_excluded", "cell_identifiers_retained", "raw_access", "sharing_policy"],
      "properties": {
        "personal_identifiers_excluded": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cell_identifiers_retained": {"type": "boolean"},
        "raw_access": {"type": "string", "minLength": 1},
        "sharing_policy": {"type": "string", "minLength": 1}
      }
    }
  }
}
