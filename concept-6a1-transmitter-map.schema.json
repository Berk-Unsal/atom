{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urban-ray-tracer.local/schema/concept-6a1-transmitter-map.schema.json",
  "title": "A.T.O.M Concept 6A.1 transmitter truth map",
  "description": "Strict mapping contract between observed serving-cell identity and configured A.T.O.M transmitters. Configuration provenance is never relabeled as a measured RF value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "map_version", "source_type", "source_citation", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "map_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/|-]{1,128}$"},
    "map_version": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_citation": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_cell_id", "observed_cell_id", "observed_pci", "plmn", "site_id", "lat", "lon", "antenna_height_m", "azimuth_deg", "tilt_deg", "frequency_ghz", "bandwidth_mhz", "tx_power_dbm", "rf_profile", "field_provenance", "source_citation"],
        "properties": {
          "atom_cell_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/|-]{1,128}$"},
          "observed_cell_id": {"type": "string", "minLength": 1},
          "observed_pci": {"type": ["integer", "null"]},
          "plmn": {"type": "string", "pattern": "^[0-9]{5,6}$"},
          "site_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/|-]{1,128}$"},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "antenna_height_m": {"type": "number", "exclusiveMinimum": 0},
          "azimuth_deg": {"type": "number"},
          "tilt_deg": {"type": "number"},
          "frequency_ghz": {"enum": [2.6, 28]},
          "bandwidth_mhz": {"type": "number", "exclusiveMinimum": 0},
          "tx_power_dbm": {"type": "number"},
          "rf_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "network_tech", "propagation_model", "frequency_ghz", "band", "bandwidth_mhz", "channel_id", "duplex_mode", "tx_power_dbm", "antenna_gain_dbi", "rx_antenna_gain_dbi", "system_loss_db", "polarization_loss_db", "radius_m", "beam_width", "antenna_height_m", "mechanical_downtilt_deg", "electrical_downtilt_deg", "orientation_deg", "horizontal_pattern_id", "vertical_pattern_id", "load_factor", "reuse_factor", "receiver_height_m", "receiver_sensitivity_dbm", "receiver_sensitivity_mode", "receiver_noise_bandwidth_hz", "receiver_noise_figure_db", "receiver_required_snr_db", "receiver_margin_db"],
            "properties": {
              "schema_version": {"const": 1},
              "network_tech": {"enum": ["4g", "5g"]},
              "propagation_model": {"const": "urban_short_range"},
              "frequency_ghz": {"enum": [2.6, 28]},
              "band": {"type": "string", "minLength": 1},
              "bandwidth_mhz": {"type": "number", "exclusiveMinimum": 0},
              "channel_id": {"type": "string", "minLength": 1},
              "duplex_mode": {"type": "string", "minLength": 1},
              "tx_power_dbm": {"type": "number"},
              "antenna_gain_dbi": {"type": "number"},
              "rx_antenna_gain_dbi": {"type": "number"},
              "system_loss_db": {"type": "number"},
              "polarization_loss_db": {"type": "number"},
              "radius_m": {"type": "number", "exclusiveMinimum": 0},
              "beam_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 360},
              "antenna_height_m": {"type": "number", "minimum": 10, "maximum": 150},
              "mechanical_downtilt_deg": {"type": "number"},
              "electrical_downtilt_deg": {"type": "number"},
              "orientation_deg": {"type": "number"},
              "horizontal_pattern_id": {"type": "string", "minLength": 1},
              "vertical_pattern_id": {"type": "string", "minLength": 1},
              "load_factor": {"type": "number", "minimum": 0, "maximum": 1},
              "reuse_factor": {"type": "integer", "minimum": 1},
              "pci": {"type": ["integer", "null"]},
              "receiver_height_m": {"type": "number", "exclusiveMinimum": 0},
              "receiver_sensitivity_dbm": {"type": "number"},
              "receiver_sensitivity_mode": {"type": "string", "minLength": 1},
              "receiver_noise_bandwidth_hz": {"type": "number", "exclusiveMinimum": 0},
              "receiver_noise_bandwidth_source": {"type": "string"},
              "receiver_noise_figure_db": {"type": "number"},
              "receiver_required_snr_db": {"type": "number"},
              "receiver_margin_db": {"type": "number"}
            }
          },
          "field_provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atom_cell_id", "observed_cell_id", "site_coordinates", "antenna_height_m", "azimuth_deg", "tilt_deg", "frequency_ghz", "bandwidth_mhz", "tx_power_dbm", "provenance"],
            "properties": {
              "atom_cell_id": {"$ref": "#/$defs/provenance"},
              "observed_cell_id": {"$ref": "#/$defs/provenance"},
              "site_coordinates": {"$ref": "#/$defs/provenance"},
              "antenna_height_m": {"$ref": "#/$defs/provenance"},
              "azimuth_deg": {"$ref": "#/$defs/provenance"},
              "tilt_deg": {"$ref": "#/$defs/provenance"},
              "frequency_ghz": {"$ref": "#/$defs/provenance"},
              "bandwidth_mhz": {"$ref": "#/$defs/provenance"},
              "tx_power_dbm": {"$ref": "#/$defs/provenance"},
              "provenance": {"$ref": "#/$defs/provenance"}
            }
          },
          "source_citation": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source"],
      "properties": {
        "status": {"enum": ["known", "configured", "inferred", "unknown"]},
        "source": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    }
  }
}
