{
  "name": "atom-desktop",
  "private": true,
  "description": "Thin desktop host for the shared A.T.O.M React and Go product.",
  "main": "main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build.cjs",
    "test": "node --test test/*.test.cjs",
    "test:runtime": "node --test test/runtime.integration.cjs",
    "test:native": "node test/smoke.mjs && node test/lifecycle.mjs && node test/security.mjs",
    "test:dev-loop": "node test/dev-loop.mjs",
    "test:storage": "node test/storage.mjs",
    "test:project-files": "node test/project-files.mjs",
    "test:reports": "node test/reports.mjs",
    "test:datasets": "node test/datasets.mjs",
    "test:diagnostics": "node test/diagnostics.mjs",
    "test:startup-budget": "node test/startup-budget.mjs",
    "test:rf-parity": "node test/rf-parity.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "node test/packaged.mjs",
    "package:deb": "node scripts/deb.mjs",
    "test:deb": "node test/deb-installed.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.10.2",
    "playwright-core": "1.61.1"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
