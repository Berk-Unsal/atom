{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urban-ray-tracer.example/docs/concept-6a-validation-schema.json",
  "title": "Concept 6A canonical RF measurement validation dataset",
  "description": "Source-independent observation contract for evidence-only validation of the production 2.6 GHz and 28 GHz RF profiles. It does not describe or activate calibration of canonical planning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_version", "source_type", "observations", "transmitters"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_type": {"type": "string", "enum": ["external_public", "local_field", "synthetic_controlled", "vendor", "unknown"]},
    "source_citation": {"type": "string"},
    "license": {"type": "string"},
    "metadata_url": {"type": "string", "format": "uri"},
    "observations": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/observation"}},
    "transmitters": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/transmitter"}}
  },
  "$defs": {
    "finite_number": {"type": "number"},
    "coordinate_lon": {"type": "number", "minimum": -180, "maximum": 180},
    "coordinate_lat": {"type": "number", "minimum": -90, "maximum": 90},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "profile": {
      "type": "object",
      "description": "The normalized production CellRFProfile for the matched cell. Defaults must be resolved before this artifact is created.",
      "required": ["schema_version", "network_tech", "propagation_model", "frequency_ghz", "bandwidth_mhz", "channel_id", "tx_power_dbm", "antenna_gain_dbi", "rx_antenna_gain_dbi", "system_loss_db", "polarization_loss_db", "radius_m", "beam_width", "antenna_height_m", "receiver_height_m", "receiver_sensitivity_dbm", "receiver_sensitivity_mode"],
      "properties": {
        "schema_version": {"const": 1},
        "network_tech": {"enum": ["4g", "5g"]},
        "propagation_model": {"enum": ["urban_short_range"]},
        "frequency_ghz": {"type": "number", "enum": [2.6, 28]},
        "band": {"type": "string"},
        "bandwidth_mhz": {"type": "number", "exclusiveMinimum": 0},
        "channel_id": {"type": "string", "minLength": 1},
        "duplex_mode": {"type": "string"},
        "tx_power_dbm": {"type": "number"},
        "antenna_gain_dbi": {"type": "number"},
        "tx_antenna_gain_dbi": {"type": "number"},
        "rx_antenna_gain_dbi": {"type": "number"},
        "system_loss_db": {"type": "number"},
        "polarization_loss_db": {"type": "number"},
        "radius_m": {"type": "number", "exclusiveMinimum": 0},
        "beam_width": {"type": "number", "exclusiveMinimum": 0},
        "antenna_height_m": {"type": "number", "exclusiveMinimum": 0},
        "mechanical_downtilt_deg": {"type": "number"},
        "electrical_downtilt_deg": {"type": "number"},
        "orientation_deg": {"type": "number"},
        "horizontal_pattern_id": {"type": "string"},
        "vertical_pattern_id": {"type": "string"},
        "load_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "reuse_factor": {"type": "integer", "minimum": 1},
        "pci": {"type": "integer", "minimum": 0},
        "receiver_height_m": {"type": "number", "exclusiveMinimum": 0},
        "receiver_sensitivity_dbm": {"type": "number"},
        "receiver_sensitivity_mode": {"enum": ["manual", "derived"]},
        "receiver_noise_bandwidth_hz": {"type": "number", "exclusiveMinimum": 0},
        "receiver_noise_bandwidth_source": {"type": "string"},
        "receiver_noise_figure_db": {"type": "number"},
        "receiver_required_snr_db": {"type": "number"},
        "receiver_margin_db": {"type": "number"}
      },
      "additionalProperties": true
    },
    "transmitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "lat", "lon", "rf_profile"],
      "properties": {
        "cell_id": {"$ref": "#/$defs/identifier"},
        "mapping_id": {"$ref": "#/$defs/identifier"},
        "site_id": {"$ref": "#/$defs/identifier"},
        "lat": {"$ref": "#/$defs/coordinate_lat"},
        "lon": {"$ref": "#/$defs/coordinate_lon"},
        "azimuth_deg": {"type": "number"},
        "rf_profile": {"$ref": "#/$defs/profile"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "campaign_id", "site_id", "technology", "frequency_ghz", "quantity", "outdoor", "los_nlos", "rx_height_m", "rx_height_source", "aggregation_method", "provenance"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/identifier"},
        "campaign_id": {"$ref": "#/$defs/identifier"},
        "campaign_version": {"type": "string"},
        "site_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "timestamp": {"type": "string", "format": "date-time"},
        "lat": {"$ref": "#/$defs/coordinate_lat"},
        "lon": {"$ref": "#/$defs/coordinate_lon"},
        "distance_m": {"type": "number", "exclusiveMinimum": 0},
        "rx_height_m": {"type": "number", "exclusiveMinimum": 0},
        "rx_height_source": {"enum": ["measured", "configured", "assumed", "unknown"]},
        "technology": {"enum": ["4g", "5g"]},
        "frequency_ghz": {"type": "number", "enum": [2.6, 28]},
        "band": {"type": "string"},
        "bandwidth_mhz": {"type": "number", "exclusiveMinimum": 0},
        "channel_id": {"type": "string"},
        "transmitter_id": {"$ref": "#/$defs/identifier"},
        "serving_cell_id": {"$ref": "#/$defs/identifier"},
        "serving_pci": {"type": "integer", "minimum": 0},
        "quantity": {"enum": ["received_power_dbm", "rsrp_dbm", "sinr_db", "rsrq_db", "rssi_dbm", "path_loss_db"]},
        "value_db": {"type": ["number", "null"]},
        "quantity_definition": {"type": "string", "minLength": 1},
        "device_id": {"type": "string"},
        "device_model": {"type": "string"},
        "antenna_id": {"type": "string"},
        "antenna_model": {"type": "string"},
        "calibration_id": {"type": "string"},
        "calibration_state": {"type": "string"},
        "antenna_gain_dbi": {"type": "number"},
        "antenna_basis": {"type": "string"},
        "motion_state": {"type": "string"},
        "sampling_method": {"type": "string"},
        "aggregation_method": {"enum": ["raw", "mean", "median", "percentile"]},
        "aggregation_percentile": {"type": "number", "minimum": 0, "maximum": 100},
        "sample_count": {"type": "integer", "minimum": 0},
        "provenance": {"type": "string", "minLength": 1},
        "quality_flags": {"type": "array", "items": {"type": "string"}},
        "los_nlos": {"enum": ["los", "nlos", "unknown"]},
        "los_source": {"type": "string"},
        "outdoor": {"type": "boolean"},
        "detection_limit_dbm": {"type": "number"},
        "censoring_status": {"enum": ["uncensored", "left_censored", "right_censored", "below_detection_limit", "not_detected"]},
        "resource_semantics": {"type": "string"},
        "interference_context_complete": {"type": "boolean"},
        "neighbor_cell_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}
      },
      "allOf": [
        {"if": {"properties": {"aggregation_method": {"const": "percentile"}}}, "then": {"required": ["aggregation_percentile"]}},
        {"if": {"properties": {"censoring_status": {"enum": ["left_censored", "right_censored", "below_detection_limit", "not_detected"]}}}, "then": {}, "else": {"required": ["value_db"]}}
      ]
    }
  },
  "quantity_semantics": {
    "residual": "measured - predicted; positive means the canonical model underpredicts",
    "compatible_pairs": {
      "received_power_dbm": "canonical received_power_dbm only",
      "rsrp_dbm": "canonical RSRP conversion from received carrier power; never RSSI",
      "sinr_db": "shared radio-quality primitive with explicit serving/resource/neighbor context",
      "rsrq_db": "shared radio-quality primitive with explicit serving/resource/neighbor context",
      "rssi_dbm": "shared radio-quality primitive RSSI; never compared with RSRP",
      "path_loss_db": "canonical propagation loss only; not an absolute received-power validation claim"
    },
    "frequency_policy": "2.6 GHz and 28 GHz are reported separately",
    "censoring_policy": "detection floors are interval/censored evidence and never exact residual values",
    "receiver_height_policy": "height and provenance are required; no silent 1.5 m default",
    "device_antenna_policy": "effects are retained as metadata and are not silently compensated",
    "aggregation_policy": "raw, mean, median, or explicit percentile are deterministic source choices; the evaluator cannot choose a statistic to reduce residual"
  },
  "readiness_policy": {
    "states": ["no_measurement_data", "insufficient_metadata", "validation_only", "calibration_unstable", "calibration_candidate", "validated_for_declared_scope"],
    "production_candidate": false,
    "calibration_active": false,
    "promotion_gate": ["independent usable observations", "complete configuration and quantity semantics", "spatial/site/campaign holdouts", "stable frequency-specific correction", "reproducible provenance", "independent review"]
  }
}
