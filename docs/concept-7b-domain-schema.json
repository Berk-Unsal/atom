{
  "artifact": "concept-7b-domain-schema",
  "artifact_version": "1.0.0",
  "status": "implemented_local_domain_boundary",
  "storage_policy": "Domain objects are adapted to the existing ProjectV2 workspace; no IndexedDB database or object-store migration is used.",
  "entities": [
    { "name": "Project", "id": "project_id", "fields": ["name", "description", "tags", "created_at", "updated_at", "active_scenario_id", "scenario_ids", "inventory_ids", "dataset_references", "report_ids", "metadata"], "excludes": ["map viewport", "drawer state", "loading", "abort controllers", "ray caches", "signal surfaces"] },
    { "name": "Inventory", "id": "inventory_id", "fields": ["project_id", "name", "description", "source_type", "current_revision_id", "source_reference", "metadata"] },
    { "name": "InventoryRevision", "id": "inventory_revision_id", "fields": ["inventory_id", "revision", "parent_revision_id", "cells", "provenance", "source_references", "content_fingerprint", "created_at", "change_summary"] },
    { "name": "InventoryCell", "id": "inventory_cell_id", "shape": "flat cell/sector record; Site is intentionally absent", "fields": ["source_key", "cell_id", "radio_technology", "is_simulated", "coordinates", "rf_profile", "antenna_pattern_reference", "inventory_source", "editable", "provenance", "metadata"] },
    { "name": "Scenario", "id": "scenario_id", "fields": ["project_id", "name", "description", "created_at", "updated_at", "current_revision_id", "parent_scenario_id", "revision_ids", "run_ids", "report_ids", "metadata"] },
    { "name": "ScenarioRevision", "id": "scenario_revision_id", "immutable": true, "fields": ["scenario_id", "revision", "parent_revision_id", "inventory_revision_id", "overrides", "planning_mode", "selected_cell_id", "selected_cell_ids", "enabled_cell_ids", "selection_geometry", "rf_affecting_settings", "receiver_assumptions", "propagation_selection", "interference_settings", "objective_constraints", "optimizer_configuration", "dataset_references", "resolved_fingerprints", "calibration_profile", "originating_run_id", "originating_solution_id", "request_inputs", "canonical_input_snapshot", "created_at", "change_summary", "provenance", "metadata"], "excludes": ["active drawer", "hovered cell", "selected map object", "map viewport", "open tabs", "loading", "notices", "errors", "request cancellation", "temporary rendering visibility"] },
    { "name": "Run", "id": "run_id", "immutable_result_envelope": true, "fields": ["run_type", "project_id", "scenario_id", "scenario_revision_id", "scenario_fingerprint", "input_fingerprint", "dataset_references", "engine", "rf_contract", "optimizer_contract", "canonical_input_snapshot", "status", "created_at", "started_at", "completed_at", "warnings", "error", "summary", "artifact_references", "details"] },
    { "name": "OptimizationSolution", "id": "optimization_solution_id", "public_identity": "optimizer_solution_id/id is retained separately", "fields": ["run_id", "optimizer_solution_id", "cell_configurations", "objectives", "stats", "score", "constraints_satisfied", "violations", "explanation_summary"] },
    { "name": "DatasetReference", "id": "dataset_id + version", "immutable": true, "fields": ["dataset_id", "version", "manifest_hash", "content_hashes", "crs", "provenance", "compatibility"] },
    { "name": "ReportDefinition", "id": "report_id", "fields": ["project_id", "scenario_id", "scenario_revision_id", "run_ids", "sections", "options", "created_at", "updated_at"] },
    { "name": "GeneratedReportArtifactReference", "id": "artifact_id", "fields": ["report_id", "project_id", "scenario_revision_id", "run_ids", "content_hash", "format", "generator_version", "generated_at", "live_generated", "artifact_reference"] }
  ],
  "override_precedence": ["ScenarioCellOverride field when explicitly set", "InventoryCell field", "existing dataset/application default"],
  "override_semantics": { "inherit": "field absent", "clear": "{ $clear: true } marker; null is not silently reinterpreted" },
  "identity_rules": { "durable_ids": ["project_id", "inventory_id", "inventory_revision_id", "scenario_id", "scenario_revision_id", "run_id", "dataset_id", "report_id", "artifact_id", "optimization_solution_id"], "not_fingerprints": ["scenario_fingerprint", "content_fingerprint", "content_hash", "optimization_run_id", "optimizer_solution_id"], "atom_scenario_v1": "never receives new entity ids" },
  "lineage_rules": { "save_current": "creates a new ScenarioRevision while keeping the existing UI snapshot label", "branch": "creates a new Scenario identity with parent_scenario_id and a child revision", "apply_solution": "creates a child ScenarioRevision and records originating_run_id/originating_solution_id" },
  "provenance_vocabulary": ["user_configured", "imported", "measured", "derived", "assumed", "default", "generated", "validated"]
}
